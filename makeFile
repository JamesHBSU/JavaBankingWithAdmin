
JAVAC = javac
JAVA = java

SOURCES = Main.java User.java Admin.java Customer.java Menu.java HasMenu.java Bank.java CheckingAccount.java SavingsAccount.java

CLASSES = $(SOURCES:.java=.class)

all: compile

compile:
	$(JAVAC) $(SOURCES)

run: compile
	$(JAVA) Main

clean:
	rm -f *.class

.PHONY: all compile run clean

